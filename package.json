{
  "name": "@synapse/cli",
  "version": "0.1.0",
  "description": "Terminal client for Synapse — chat, edit files, and run code from a project directory, without VSCode or the web UI.",
  "private": true,
  "type": "module",
  "bin": {
    "synapse": "./dist/cli.js"
  },
  "files": [
    "dist",
    "vendor"
  ],
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "start": "node --loader ts-node/esm src/cli.tsx",
    "release": "bash ./scripts/release.sh"
  },
  "dependencies": {
    "@inkjs/ui": "^1.0.0",
    "@synapse/protocol": "file:./vendor/synapse-protocol-0.1.0.tgz",
    "@synapse/tokens": "file:./vendor/synapse-tokens-0.1.0.tgz",
    "ink": "^4.4.1",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^5.0.1",
    "meow": "^13.2.0",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "typescript": "^5.3.0"
  }
}
